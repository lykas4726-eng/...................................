
from abc import ABC, abstractmethod

ADMIN_PASSWORD = "admin123"

# Лямбда: формат ціни ххх.ххгрн
format_price = lambda value: f"{value:.2f}грн"


# ---------------------------- Товари ----------------------------
class Product(ABC):
    def __init__(self, product_id: int, name: str, price: float, stock: int):
        self._id = product_id
        self._name = name
        self._price = price
        self._stock = stock

    @property
    def id(self) -> int:
        return self._id

    @property
    def name(self) -> str:
        return self._name

    @property
    def price(self) -> float:
        return self._price

    @property
    def stock(self) -> int:
        return self._stock

    def reduce_stock(self, qty: int) -> None:
        if qty > self._stock:
            raise ValueError(f"Недостатньо товару '{self._name}' на складі")
        self._stock -= qty

    @abstractmethod
    def details(self) -> str:
        """Додаткова інформація про товар (поліморфізм)."""

    def __str__(self) -> str:
        return f"[{self._id}] {self._name} - {format_price(self._price)} ({self.details()})"


class FoodProduct(Product):
    def __init__(self, product_id, name, price, stock, shelf_life_days: int):
        super().__init__(product_id, name, price, stock)
        self._shelf_life = shelf_life_days

    def details(self) -> str:
        return f"Харчові, термін придатності: {self._shelf_life} дн."


class ElectronicsProduct(Product):
    def __init__(self, product_id, name, price, stock, warranty_months: int):
        super().__init__(product_id, name, price, stock)
        self._warranty = warranty_months

    def details(self) -> str:
        return f"Електроніка, гарантія: {self._warranty} міс."


# ---------------------------- Каталог ----------------------------
class Catalog:
    def __init__(self, products: list[Product]):
        self._products = {p.id: p for p in products}

    def get(self, product_id: int) -> Product | None:
        return self._products.get(product_id)

    def all(self, sort_by_price: bool = False) -> list[Product]:
        items = list(self._products.values())
        if sort_by_price:
            items.sort(key=lambda p: p.price)  # лямбда для сортування
        return items

    def available(self) -> list[Product]:
        return list(filter(lambda p: p.stock > 0, self._products.values()))  # лямбда-фільтр


# ---------------------------- Кошик ----------------------------
class Cart:
    def __init__(self):
        self._items: dict[int, tuple[Product, int]] = {}

    def add(self, product: Product, qty: int) -> None:
        if qty <= 0:
            raise ValueError("Кількість має бути більше 0")
        in_cart = self._items[product.id][1] if product.id in self._items else 0
        if in_cart + qty > product.stock:
            raise ValueError(f"Доступно лише {product.stock} шт. '{product.name}'")
        self._items[product.id] = (product, in_cart + qty)

    def remove(self, product_id: int) -> None:
        if product_id not in self._items:
            raise ValueError("Такого товару немає в кошику")
        del self._items[product_id]

    def items(self) -> list[tuple[Product, int]]:
        return list(self._items.values())

    def is_empty(self) -> bool:
        return not self._items

    def total(self) -> float:
        # лямбда всередині map
        return sum(map(lambda item: item[0].price * item[1], self._items.values()))

    def clear(self) -> None:
        self._items.clear()


# ---------------------------- Магазин ----------------------------
class Shop:
    def __init__(self, catalog: Catalog):
        self.catalog = catalog

    def checkout (self, cart: Cart) -> float:
        if cart.is_empty():
            raise ValueError("Кошик порожній")
        total = cart.total()
        for product, qty in cart.items():
            product.reduce_stock(qty)
        cart.clear()
        return total


# ---------------------------- Консольний інтерфейс ----------------------------
def read_int(prompt: str) -> int:
    while True:
        try:
            return int(input(prompt))
        except ValueError:
            print("Введіть ціле число.")


class ConsoleApp:
    def __init__(self, shop: Shop):
        self._shop = shop
        self._cart = Cart()
        # Меню як словники лямбда-функцій (замість if/elif)
        self._customer_menu = {
            "1": ("Переглянути каталог", lambda: self._show_catalog()),
            "2": ("Додати товар у кошик", lambda: self._add_to_cart()),
            "3": ("Видалити товар з кошика", lambda: self._remove_from_cart()),
            "4": ("Переглянути кошик", lambda: self._show_cart()),
            "5": ("Купити товари з кошика", lambda: self._buy()),
            "6": ("Увійти як адміністратор", lambda: self._admin_login()),
        }
        self._admin_menu = {
            "1": ("Показати залишки", lambda: self._show_stock()),
        }

    def run(self) -> None:
        self._loop("МАГАЗИН", self._customer_menu, "0 - Вихід")
        print("До побачення!")

    def _loop(self, title: str, menu: dict, exit_label: str) -> None:
        while True:
            print(f"\n=== {title} ===")
            for key, (label, _) in menu.items():
                print(f"{key} - {label}")
            print(exit_label)
            choice = input("Ваш вибір: ").strip()
            if choice == "0":
                return
            action = menu.get(choice)
            if action is None:
                print("Невірний пункт меню.")
                continue
            try:
                action [1] ()
            except ValueError as err:
                print(f"Помилка: {err}")

    # --- дії покупця ---
    def _show_catalog(self) -> None:
        print("\nКаталог (за зростанням ціни):")
        for p in self._shop.catalog.all(sort_by_price=True):
            status = "" if p.stock > 0 else " - немає в наявності"
            print(f"{p}{status}")

    def _add_to_cart(self) -> None:
        product = self._shop.catalog.get(read_int("ID товару: "))
        if product is None:
            raise ValueError("Товару з таким ID не існує")
        self._cart.add(product, read_int("Кількість: "))
        print(f"'{product.name}' додано в кошик.")

    def _remove_from_cart(self) -> None:
        self._cart.remove(read_int("ID товару для видалення: "))
        print("Товар видалено з кошика.")

    def _show_cart(self) -> None:
        if self._cart.is_empty():
            print("Кошик порожній.")
            return
        print("\nКошик:")
        for product, qty in self._cart.items():
            print(f"[{product.id}] {product.name} x{qty} = {format_price(product.price * qty)}")
        print(f"Разом: {format_price(self._cart.total())}")

    def _buy(self) -> None:
        self._show_cart()
        if self._cart.is_empty():
            return
        if input("Підтвердити покупку? (т/н): ").strip().lower() == "т":
            total = self._shop.checkout(self._cart)
            print(f"Покупку здійснено! Сплачено: {format_price(total)}")
        else:
            print("Покупку скасовано.")

    # --- дії адміністратора ---
    def _admin_login(self) -> None:
        if input("Пароль адміністратора: ") != ADMIN_PASSWORD:
            raise ValueError("Невірний пароль")
        self._loop("АДМІНІСТРАТОР", self._admin_menu, "0 - Вийти з режиму адміністратора")

    def _show_stock(self) -> None:
        print("\nЗалишки на складі:")
        for p in self._shop.catalog.all():
            print(f"[{p.id}] {p.name}: {p.stock} шт.")
        total_value = sum(map(lambda p: p.price * p.stock, self._shop.catalog.all()))
        print(f"Загальна вартість залишків: {format_price(total_value)}")


def main() -> None:
    catalog = Catalog([
        FoodProduct(1, "Шоколад", 30, 22, 18),
        FoodProduct(2, "Кава в зернах", 32.00, 10, 35),
        ElectronicsProduct(3, "Навушники", 12, 5, 2),
        ElectronicsProduct(4, "Павербанк", 89, 7, 4),
        FoodProduct(5, "Печиво", 38, 0, 9),
    ])
    ConsoleApp(Shop(catalog)).run()

#Точка входу (запуск програми)#
if __name__ == "__main__":
    main()
